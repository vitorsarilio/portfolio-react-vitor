# LLM provider API key (Anthropic)
# Get yours at: https://console.anthropic.com/settings/keys
LLM_API_KEY=your_llm_api_key_here

# Production frontend URL — used for CORS (e.g. https://portfolio-vitor.vercel.app)
# Leave empty to allow only localhost during development
FRONTEND_URL=https://your-vercel-domain.vercel.app

# Port for local development (default: 3001)
PORT=3001
